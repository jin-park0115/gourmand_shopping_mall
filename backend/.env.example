# 실제 값은 .env 에 작성하고 절대 커밋하지 않습니다.
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/gourmand
CORS_ORIGINS=http://localhost:3000
# 32바이트 이상 무작위 값 (예: python -c "import secrets; print(secrets.token_hex(32))"). 바꾸면 기존 로그인은 모두 풀려요
# 비워 두거나 change-me 그대로면 서버가 시작되지 않아요
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# 시드 계정 (uv run python scripts/seed.py). 비밀번호를 비워 두면 그 계정은 만들지 않아요
ADMIN_EMAIL=admin@gourmand.com
ADMIN_PASSWORD=
CUSTOMER_EMAIL=customer@gourmand.com
CUSTOMER_PASSWORD=
